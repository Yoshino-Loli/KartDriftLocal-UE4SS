<Project Sdk="Microsoft.NET.Sdk">

  <!-- The launcher's local server (gateway + profile store + vehicle logic)
       compiled as a native shared library, so an in-process loader such as a
       UE4SS C++ mod can start it without rewriting the C# logic.
       Published with: dotnet publish -p:NativeLib=Shared -p:PublishAot=true -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>KartDriftLocal.Core</AssemblyName>
    <RootNamespace>KartDriftLocal</RootNamespace>
    <NativeLib>Shared</NativeLib>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <StripSymbols>true</StripSymbols>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" Exclude="Program.cs;ConsoleUi.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(LocalDataBundle)' != ''">
    <EmbeddedResource Include="$(LocalDataBundle)" LogicalName="LocalData.zip" />
  </ItemGroup>

</Project>
